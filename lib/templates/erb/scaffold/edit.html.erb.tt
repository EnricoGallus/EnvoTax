<%% content_for :title, "Editing <%= human_name.downcase %>" %>

<div class="w-full">
  <h1 class="font-bold text-4xl">Editing <%= human_name.downcase %></h1>

  <%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>

  <%%= link_to t('table.show')', <%= model_resource_name(prefix: "@") %>, class: "btn btn-primary" %>
  <%%= link_to t('table.back'), <%= index_helper(type: :path) %>, class: "btn" %>
</div>
