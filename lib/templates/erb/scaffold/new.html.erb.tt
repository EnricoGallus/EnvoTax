<%% content_for :title, t('<%= singular_table_name %>.new.content_title') %>

<div class="w-full">
  <h1 class="font-bold text-4xl"><%%= t('<%= singular_table_name %>.new.title') %></h1>

  <%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>

  <%%= link_to t('table.back'), <%= index_helper(type: :path) %>, class: "btn" %>
</div>
