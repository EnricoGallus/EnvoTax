<%% content_for :title, t('<%= singular_table_name %>.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%%= t('<%= singular_table_name %>.index.title') %></h1>
    <%%= link_to t('<%= singular_table_name %>.index.new'), new_<%= singular_route_name %>_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="<%= plural_table_name %>" class="min-w-full divide-y divide-gray-200 space-y-5">
  <%% if @<%= plural_table_name %>.any? %>
    <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
      <table class="table">
        <thead>
        <tr>
        <% attributes.each do |attribute| -%>
          <th><%%= sort_link(@q, :<%= attribute.name %>, t('activerecord.attributes.<%= singular_table_name %>.<%= attribute.name %>')) %></th>
        <% end -%>
          <th><%%= t('table.actions') %></th>
        </tr>
        </thead>
        <tbody>
        <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
          <tr id="<%%= dom_id <%= singular_table_name %> %>">
          <% attributes.each do |attribute| -%>
            <td><%%= <%= singular_table_name %>.<%= attribute.name %> %></td>
          <% end -%>
            <td>
                <%%= link_to t('table.show'), <%= model_resource_name(singular_table_name) %>, class: "btn btn-accent" %>
                <%%= link_to t('table.edit'), <%= edit_helper(singular_table_name, type: :path) %>, class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%%= button_to t('table.delete'), <%= model_resource_name(singular_table_name) %>, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
            </td>
          </tr>
        <%% end %>
        </tbody>
      </table>
    </div>
  <%% else %>
    <p class="text-center my-10"><%%= t('<%= singular_table_name %>.index.none_found') %></p>
  <%% end %>
  </div>
</div>