<% content_for :title, @content_title %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= @title %></h1>
    <%= link_to @new_text, @new_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="<%= @model_name.pluralize %>" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @collection.any? %>
      <%= content %>
    <% else %>
      <p class="text-center my-10"><%= t("#{@model_name}.index.none_found") %></p>
    <% end %>
  </div>
</div>