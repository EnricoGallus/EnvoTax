<%= render(IndexPageComponent.new(
  content_title: t('client.index.content_title'),
  title: t('client.index.title'),
  model_name: 'client',
  new_path: new_client_path,
  new_text: t('client.index.new'),
  collection: @clients
)) do %>
  <%= render(DataTableComponent.new(collection: @clients)) do |component| %>
    <% component.with_headers do %>
      <th><%= t('activerecord.attributes.client.name') %></th>
      <th><%= t('activerecord.attributes.client.hourly_rate') %></th>
    <% end %>

    <% @clients.each do |client| %>
      <% component.with_row do %>
        <td><%= client.name %></td>
        <td><%= client.hourly_rate.format %></td>
      <% end %>
    <% end %>
  <% end %>
<% end %>
