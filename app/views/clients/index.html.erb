<% content_for :title, t('clients.title_index') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('clients.header') %></h1>
    <%= link_to t('table.new'), new_client_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="clients" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @clients.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= t('clients.table.name') %></th>
            <th><%= t('clients.table.currency') %></th>
            <th><%= t('clients.table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @clients.each do |client| %>
            <tr id="<%= dom_id client %>">
              <td><%= client.name %></td>
              <td><%= client.currency %></td>
              <td>
                <%= link_to t('table.show'), client, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_client_path(client), class: "btn btn-primary" %>
                <div class="inline-block">
                  <%= button_to t('table.delete'), client, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('clients.none_found') %></p>
    <% end %>
  </div>
</div>
