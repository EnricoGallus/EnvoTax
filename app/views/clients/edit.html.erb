<% content_for :title, t('clients.title_edit') %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing client</h1>

  <%= render "form", client: @client %>

  <div class="flex justify-between items-center pt-5">
    <%= link_to t('actions.show'), @client, class: "btn btn-primary" %>
    <%= link_to t('actions.back'), clients_path, class: "btn btn-neutral" %>
  </div>
</div>
