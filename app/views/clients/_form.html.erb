<%= form_with(model: client, class: "contents") do |form| %>
  <% if client.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(client.errors.count, "error") %> prohibited this client from being saved:</h2>

      <ul class="list-disc ml-6">
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: ["input w-full validator", {"border-red-400 focus:outline-red-600": client.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :hourly_rate, class: "label" %>
    <%= form.number_field :hourly_rate, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": client.errors[:hourly_rate].none?, "border-red-400 focus:outline-red-600": client.errors[:hourly_rate].any?}] %>
  </div>

  <%= form.fields_for :address do |address_form| %>
    <%= render 'address/form', form: address_form, address: client.address %>
  <% end %>

  <%= form.fields_for :bank_account do |bank_account_form| %>
    <%= render 'bank_accounts/form', form: bank_account_form, bank_account: client.bank_account %>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
