<%= form_with(model: client, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: client } %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, class: ["input w-full validator", { "border-red-400 focus:outline-red-600": client.errors[:name].any? }] %>
    </div>

    <div>
      <%= form.label :hourly_rate, class: "label" %>
      <%= form.number_field :hourly_rate, class: ["input w-full", { "border-gray-400 focus:outline-blue-600": client.errors[:hourly_rate].none?, "border-red-400 focus:outline-red-600": client.errors[:hourly_rate].any? }] %>
    </div>

  </div>

  <%= form.fields_for :address do |address_form| %>
    <%= render 'address/form', form: address_form, address: client.address %>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
