<%= form_with(model: client, class: "contents") do |form| %>
  <% if client.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(client.errors.count, "error") %> prohibited this client from being saved:</h2>

      <ul class="list-disc ml-6">
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["input validator", {"border-red-400 focus:outline-red-600": client.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :currency %>
    <%= form.select :currency, Client.currencies.keys.map { |currency| [currency.humanize, currency] }, {}, class: ["select", {"border-red-400 focus:outline-red-600": client.errors[:currency].any?}] %>
  </div>

  <%= form.fields_for :address do |address_form| %>
    <%= render 'address/form', form: address_form, address: client.address %>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
