<% content_for :title, t('clients.title_show') %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing client</h1>

  <%= render @client %>

  <div class="flex justify-between items-center">
    <%= link_to t('actions.edit'), edit_client_path(@client), class: "btn btn-primary" %>
    <%= link_to t('actions.back'), clients_path, class: "btn btn-neutral" %>
    <div class="inline-block">
      <%= button_to t('actions.delete'), @client, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('actions.confirmation') } %>
    </div>
  </div>
</div>
