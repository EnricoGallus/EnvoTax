<% content_for :title, t('client.show.content_title') %>

<div class="w-full">

  <h1 class="font-bold text-4xl"><%= t('client.show.title') %></h1>

  <%= render @client %>

  <%= link_to t('table.edit'), edit_client_path(@client), class: "btn btn-primary" %>
  <%= link_to t('table.back'), clients_path, class: "btn" %>
  <%= button_to t('table.delete'), @client, method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: t('table.delete_confirmation') } %>
</div>
