<% content_for :title, t('clients.title_show') %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl">Showing client</h1>

  <%= render @client %>

  <div class="flex justify-between items-center">
    <%= link_to t('table.edit'), edit_client_path(@client), class: "btn btn-primary" %>
    <%= link_to t('table.back'), clients_path, class: "btn btn-neutral" %>
    <div class="inline-block">
      <%= button_to t('table.delete'), @client, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
    </div>
  </div>
</div>
