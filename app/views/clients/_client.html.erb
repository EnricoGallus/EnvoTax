<div id="<%= dom_id client %>" class="my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= client.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Currency:</strong>
    <%= client.currency %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Address:</strong>
    <%= client.address_id %>
  </div>
</div>
