<div id="<%= dom_id client %>">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 py-5">
    <div>
      <strong class="block font-medium mb-1"><%= t('activerecord.attributes.client.name') %>:</strong>
      <%= client.name %>
    </div>
    <div>
      <strong class="block font-medium mb-1"><%= t('activerecord.attributes.client.hourly_rate') %>:</strong>
      <%= client.hourly_rate.format %>
    </div>
    <div>
      <strong class="block font-medium mb-1"><%= t('activerecord.attributes.client.calculation_mode') %>:</strong>
      <%= client.calculation_mode_i18n %>
    </div>
  </div>
</div>
