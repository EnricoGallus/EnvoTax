<div id="<%= dom_id bank_account %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Account holder:</strong>
    <%= bank_account.account_holder %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Bank name:</strong>
    <%= bank_account.bank_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Branch code:</strong>
    <%= bank_account.branch_code %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Account number:</strong>
    <%= bank_account.account_number %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Accountable:</strong>
    <%= bank_account.accountable_id %>
  </div>
</div>
