<% content_for :title, t('bank_account.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('bank_account.index.title') %></h1>
    <%= link_to t('bank_account.index.new'), new_bank_account_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="bank_accounts" class="min-w-full divide-y divide-gray-200 space-y-5">
  <% if @bank_accounts.any? %>
    <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
      <table class="table">
        <thead>
        <tr>
                  <th><%= sort_link(@q, :account_holder, t('activerecord.attributes.bank_account.account_holder')) %></th>
                  <th><%= sort_link(@q, :bank_name, t('activerecord.attributes.bank_account.bank_name')) %></th>
                  <th><%= sort_link(@q, :branch_code, t('activerecord.attributes.bank_account.branch_code')) %></th>
                  <th><%= sort_link(@q, :account_number, t('activerecord.attributes.bank_account.account_number')) %></th>
                  <th><%= sort_link(@q, :accountable, t('activerecord.attributes.bank_account.accountable')) %></th>
                  <th><%= t('table.actions') %></th>
        </tr>
        </thead>
        <tbody>
        <% @bank_accounts.each do |bank_account| %>
          <tr id="<%= dom_id bank_account %>">
                      <td><%= bank_account.account_holder %></td>
                      <td><%= bank_account.bank_name %></td>
                      <td><%= bank_account.branch_code %></td>
                      <td><%= bank_account.account_number %></td>
                      <td><%= bank_account.accountable %></td>
                      <td>
                <%= link_to t('table.show'), bank_account, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_bank_account_path(bank_account), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), bank_account, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-center my-10"><%= t('bank_account.index.none_found') %></p>
  <% end %>
  </div>
</div>