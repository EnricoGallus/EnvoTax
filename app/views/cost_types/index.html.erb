<%= render(IndexPageComponent.new(
  content_title: t('cost_type.index.content_title'),
  title: t('cost_type.index.title'),
  model_name: 'cost_type',
  new_path: new_cost_type_path,
  new_text: t('cost_type.index.new'),
  collection: @cost_types
)) do %>
  <%= render(DataTableComponent.new(collection: @cost_types)) do |component| %>
    <% component.with_headers do %>
      <th><%= sort_link(@q, :name, t('activerecord.attributes.cost_type.name')) %></th>
    <% end %>

    <% @cost_types.each do |cost_type| %>
      <% component.with_row do %>
        <td><%= cost_type.name %></td>
      <% end %>
    <% end %>
  <% end %>
<% end %>