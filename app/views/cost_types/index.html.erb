<% content_for :title, t('cost type.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('cost type.index.title') %></h1>
    <%= link_to t('cost type.index.new'), new_cost_type_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="cost_types" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @cost_types.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= sort_link(@q, :name, t('activerecord.attributes.cost_type.name')) %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @cost_types.each do |cost_type| %>
            <tr id="<%= dom_id cost_type %>">
              <td><%= cost_type.name %></td>
              <td>
                <%= link_to t('table.show'), cost_type, class: "btn btn-accent" %>
                <%= link_to t('table.edit'), edit_cost_type_path(cost_type), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), cost_type, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('cost_type.index.none_found') %></p>
    <% end %>
  </div>
</div>