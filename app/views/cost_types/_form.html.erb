<%= form_with(model: cost_type, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: cost_type } %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": cost_type.errors[:name].none?, "border-red-400 focus:outline-red-600": cost_type.errors[:name].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
