<% content_for :title, t('contract.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('contract.index.title') %></h1>
    <%= link_to t('contract.index.new'), new_contract_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="contracts" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @contracts.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= sort_link(@q, :name, t('activerecord.attributes.contract.name')) %></th>
            <th><%= sort_link(@q, :client_name, t('activerecord.attributes.contract.client')) %></th>
            <th><%= sort_link(@q, :budget_limit_cents, t('activerecord.attributes.contract.budget_limit')) %></th>
            <th><%= sort_link(@q, :start_date, t('activerecord.attributes.contract.start_date')) %></th>
            <th><%= sort_link(@q, :end_date, t('activerecord.attributes.contract.end_date')) %></th>
            <th><%= sort_link(@q, :status, t('activerecord.attributes.contract.status')) %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @contracts.each do |contract| %>
            <tr id="<%= dom_id contract %>">
              <td><%= contract.name %></td>
              <td><%= contract.client.name %></td>
              <td><%= contract.budget_limit.format %></td>
              <td><%= contract.start_date %></td>
              <td><%= contract.end_date %></td>
              <td><%= contract.status %></td>
              <td>
                <%= link_to t('table.show'), contract, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_contract_path(contract), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), contract, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('contract.index.none_found') %></p>
    <% end %>
  </div>
</div>