<%= render(IndexPageComponent.new(
  content_title: t('contract.index.content_title'),
  title: t('contract.index.title'),
  model_name: 'contract',
  new_path: new_contract_path,
  new_text: t('contract.index.new'),
  collection: @contracts
)) do %>
  <%= render(DataTableComponent.new(collection: @contracts)) do |component| %>
    <% component.with_headers do %>
      <th><%= sort_link(@q, :name, t('activerecord.attributes.contract.name')) %></th>
      <th><%= sort_link(@q, :client_name, t('activerecord.attributes.contract.client')) %></th>
      <th><%= sort_link(@q, :process_time_entries, t('activerecord.attributes.contract.process_time_entries')) %></th>
      <th><%= sort_link(@q, :status, t('activerecord.attributes.contract.status')) %></th>
    <% end %>

    <% @contracts.each do |contract| %>
      <% component.with_row do %>
        <td><%= contract.name %></td>
        <td><%= contract.client.name %></td>
        <td><%= contract.process_time_entries %></td>
        <td><%= contract.status %></td>
      <% end %>
    <% end %>
  <% end %>
<% end %>