<% content_for :title, "Showing contract" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing contract</h1>

  <%= render @contract %>

  <%= link_to t('table.edit'), edit_contract_path(@contract), class: "btn btn-primary" %>
  <%= link_to t('table.back'), contracts_path, class: "btn" %>
  <div class="sm:inline-block mt-2 sm:mt-0 sm:ml-2">
    <%= button_to t('table.delete'), @contract, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
  </div>
</div>
