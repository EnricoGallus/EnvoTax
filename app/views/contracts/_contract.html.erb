<div id="<%= dom_id contract %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= contract.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= contract.client.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= contract.status %>
  </div>

  <h1>Contract Instances</h1>

  <%= render partial: "contract_instances/index", locals: { contract: @contract, contract_instances: @contract_instances} %>
</div>
