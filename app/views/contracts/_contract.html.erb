<div id="<%= dom_id contract %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= contract.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= contract.client.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Budget limit cents:</strong>
    <%= contract.budget_limit&.format %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= contract.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= contract.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= contract.status %>
  </div>
</div>
