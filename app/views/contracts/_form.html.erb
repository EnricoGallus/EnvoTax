<%= form_with(model: contract, class: "contents") do |form| %>
  <% if contract.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(contract.errors.count, "error") %> prohibited this contract from being saved:</h2>

      <ul class="list-disc ml-6">
        <% contract.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract.errors[:name].none?, "border-red-400 focus:outline-red-600": contract.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :client_id %>
    <%= form.select :client_id, options_from_collection_for_select(Client.all, :id, :name, selected: contract.client_id), { include_blank: true }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": contract.errors[:client_id].none?, "border-red-400 focus:outline-red-600": contract.errors[:client_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :budget_limit_cents %>
    <%= form.number_field :budget_limit, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract.errors[:budget_limit_cents].none?, "border-red-400 focus:outline-red-600": contract.errors[:budget_limit_cents].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :start_date %>
    <%= form.date_field :start_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract.errors[:start_date].none?, "border-red-400 focus:outline-red-600": contract.errors[:start_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :end_date %>
    <%= form.date_field :end_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract.errors[:end_date].none?, "border-red-400 focus:outline-red-600": contract.errors[:end_date].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
