<%= turbo_stream.update "new_time_entry" do %>
  <%= link_to t('dashboard.time_entry.new_button'), new_time_entry_path(format: :turbo_stream), data: { turbo_prefetch: false }, class: "btn btn-primary" %>
<% end %>
<%= turbo_stream.replace "today" do %>
  <%= render(Dashboard::LazyComponent.new(id: "today", path: today_dashboard_index_path)) %>
<% end %>