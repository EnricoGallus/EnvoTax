<div class="container justify-center items-center mx-auto mt-10 w-96">

  <h2 class="text-center"><%= t('devise.views.forgot_password.title') %></h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: "input w-full", autofocus: true, autocomplete: "email" %>
    </div>

    <div class="actions">
      <%= f.submit t('devise.views.forgot_password.submit') %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
