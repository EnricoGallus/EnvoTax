<div class="container justify-center items-center mx-auto mt-10 w-96">

  <h2 class="text-center"><%= t('devise.views.login.title') %></h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: "input w-full", autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: "input w-full", autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <%= f.label :remember_me, class: "label" do |label| %>
        <%= f.check_box :remember_me, class: "checkbox" %>
        <%= label %>
      <% end %>
    <% end %>

    <div class="actions">
      <%= f.submit t('devise.views.login.submit'), class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>