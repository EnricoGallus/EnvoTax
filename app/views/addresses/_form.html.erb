<fieldset class="fieldset pb-5">
  <legend class="fieldset-legend"><%= t('activerecord.models.address.one') %></legend>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :postal_code, class: "label" %>
      <%= form.text_field :postal_code, class: ["input w-full", { "border-red-400 focus:outline-red-600": address.errors[:postal_code].any? }] %>
    </div>

    <div>
      <%= form.label :prefecture, class: "label" %>
      <%= form.text_field :prefecture, class: ["input w-full", { "border-red-400 focus:outline-red-600": address.errors[:prefecture].any? }] %>
    </div>

    <div>
      <%= form.label :city, class: "label" %>
      <%= form.text_field :city, class: ["input w-full", { "border-red-400 focus:outline-red-600": address.errors[:city].any? }] %>
    </div>

    <div>
      <%= form.label :street, class: "label" %>
      <%= form.text_field :street, class: ["input w-full", { "border-red-400 focus:outline-red-600": address.errors[:street].any? }] %>
    </div>

    <div>
      <%= form.label :building, class: "label" %>
      <%= form.text_field :building, class: ["input w-full", { "border-red-400 focus:outline-red-600": address.errors[:building].any? }] %>
    </div>

    <div>
      <%= form.label :country, class: "label" %>
      <%= form.select :country, Address.countries.keys.map { |country| [country.humanize, country] }, {}, class: ["select w-full", { "border-red-400 focus:outline-red-600": address.errors[:country].any? }] %>
    </div>
  </div>
</fieldset>