<% content_for :title, t('category.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('category.index.title') %></h1>
    <%= link_to t('category.index.new'), new_category_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="categories" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @categories.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= sort_link(@q, :name, t('activerecord.attributes.category.name')) %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @categories.each do |category| %>
            <tr id="<%= dom_id category %>">
              <td><%= category.name %></td>
              <td>
                <%= link_to t('table.show'), category, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_category_path(category), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), category, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('category.index.none_found') %></p>
    <% end %>
  </div>
</div>