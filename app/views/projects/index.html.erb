<%= render(IndexPageComponent.new(
  content_title: t('projects.index.content_title'),
  title: t('projects.index.title'),
  model_name: 'project',
  new_path: new_project_path,
  new_text: t('projects.index.new'),
  collection: @projects
)) do %>
  <%= render(DataTableComponent.new(collection: @projects)) do |component| %>
    <% component.with_headers do %>
      <th><%= t('activerecord.attributes.project.name') %></th>
      <th><%= t('activerecord.attributes.project.client') %></th>
    <% end %>

    <% @projects.each do |project| %>
      <% component.with_row do %>
        <td><%= project.name %></td>
        <td><%= project.client.name %></td>
      <% end %>
    <% end %>
  <% end %>
<% end %>