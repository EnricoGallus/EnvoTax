<% content_for :title, "Projects" %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('projects.header') %></h1>
    <%= link_to t('table.new'), new_project_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="projects" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @projects.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= t('activerecord.attributes.project.name') %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @projects.each do |project| %>
            <tr id="<%= dom_id project %>">
              <td><%= project.name %></td>
              <td>
                <%= link_to t('table.show'), project, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_project_path(project), class: "btn btn-primary" %>
                <%= button_to t('table.delete'), project, method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: t('table.delete_confirmation') } %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('projects.none_found') %></p>
    <% end %>
  </div>
</div>
