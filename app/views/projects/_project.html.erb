<div id="<%= dom_id project %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= project.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= project.client_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Hourly rate:</strong>
    <%= project.hourly_rate %>
  </div>
</div>
