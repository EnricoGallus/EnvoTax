<% content_for :title, t('time_entry.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('time_entry.index.title') %></h1>
    <%= link_to t('time_entry.index.new'), new_time_entry_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="time_entries" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @time_entries.any? %>
      <% @time_entries.group_by { |entry| entry.date }.each do |date, entries| %>
        <div class="my-6">
          <div class="grid grid-cols-2 justify-between items-center bg-base-200 p-2">
            <h2 class="text-xl font-semibold"><%= l date, format: :long %></h2>
            <p class="text-xl text-end">Total: <%= format_spent_time(entries.sum(&:spent_time_in_seconds)) %></p>
          </div>
          <%= render 'table', q: @q, entries: entries %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10"><%= t('expense.index.none_found') %></p>
    <% end %>
  </div>
  <div class="flex justify-center items-center">
    <%== pagy_nav(@pagy) %>
  </div>
</div>
