<div id="<%= dom_id time_entry %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Date:</strong>
    <%= time_entry.date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Time from:</strong>
    <%= time_entry.time_from %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Time to:</strong>
    <%= time_entry.time_to %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= time_entry.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Project:</strong>
    <%= time_entry.project.name %>
  </div>
</div>
