<div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
  <table class="table">
    <thead>
    <tr>
      <th><%= sort_link(q, :date, t('activerecord.attributes.time_entry.date')) %></th>
      <th><%= sort_link(q, :name, t('activerecord.attributes.time_entry.name')) %></th>
      <th><%= sort_link(q, :time_from, t('activerecord.attributes.time_entry.time_from')) %></th>
      <th><%= sort_link(q, :time_to, t('activerecord.attributes.time_entry.time_to')) %></th>
      <th><%= sort_link(q, :project_name, t('activerecord.attributes.time_entry.project')) %></th>
      <th><%= t('clients.table.actions') %></th>
    </tr>
    </thead>
    <tbody>
    <% entries.each do |time_entry| %>
      <tr id="<%= dom_id time_entry %>">
        <td><%= time_entry.date %></td>
        <td><%= time_entry.name %></td>
        <td><%= l time_entry.time_from, format: :time_only %></td>
        <td><%= l time_entry.time_to, format: :time_only %></td>
        <td><%= time_entry.project&.name %></td>
        <td>
          <%= link_to t('table.show'), time_entry, class: "btn btn-primary" %>
          <%= link_to t('table.edit'), edit_time_entry_path(time_entry), class: "btn btn-primary" %>
          <div class="inline-block">
            <%= button_to t('table.delete'), time_entry, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>