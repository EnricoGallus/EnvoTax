<%= form_with(model: time_entry, class: "contents") do |form| %>
  <% if time_entry.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(time_entry.errors.count, "error") %> prohibited this time_entry from being saved:</h2>

      <ul class="list-disc ml-6">
        <% time_entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :date %>
    <%= form.date_field :date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": time_entry.errors[:date].none?, "border-red-400 focus:outline-red-600": time_entry.errors[:date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :time_from %>
    <%= form.time_field :time_from, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": time_entry.errors[:time_from].none?, "border-red-400 focus:outline-red-600": time_entry.errors[:time_from].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :time_to %>
    <%= form.time_field :time_to, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": time_entry.errors[:time_to].none?, "border-red-400 focus:outline-red-600": time_entry.errors[:time_to].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": time_entry.errors[:name].none?, "border-red-400 focus:outline-red-600": time_entry.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :project_id %>
    <%= form.select :project_id, options_from_collection_for_select(Project.all, :id, :name, selected: time_entry.project_id), { }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": time_entry.errors[:project_id].none?, "border-red-400 focus:outline-red-600": time_entry.errors[:project_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
