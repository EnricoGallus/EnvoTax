<%= form_with(model: user, class: "contents", url: account_path) do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: user } %>

  <div class="my-5">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: ["input w-full validator", {"border-red-400 focus:outline-red-600": user.errors[:name].any?}] %>
  </div>

  <%= form.fields_for :address do |address_form| %>
    <%= render 'address/form', form: address_form, address: user.address %>
  <% end %>

  <%= form.fields_for :bank_account do |bank_account_form| %>
    <%= render 'bank_accounts/form', form: bank_account_form, bank_account: user.bank_account %>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
