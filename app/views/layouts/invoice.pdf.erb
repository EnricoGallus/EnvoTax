<!-- app/views/layouts/invoice.pdf.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= t('invoice.header.title') %></title>

  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" %>
  <style>
      body {
          line-height: 1.5;
      }
      h1 {
          font-size: 24px;
          margin-bottom: 20px;
      }
      h5 {
          font-size: 16px;
          margin-top: 15px;
          margin-bottom: 10px;
      }
      .invoice-header {
          margin-bottom: 30px;
          padding-bottom: 20px;
          border-bottom: 1px solid #eee;
      }
      .section {
          margin-bottom: 30px;
      }
      .page-break {
          page-break-after: always;
      }
      .table-borderless,
      .table-borderless thead,
      .table-borderless tbody,
      .table-borderless th,
      .table-borderless td,
      .table-borderless tr {
          border: 0 none !important;
      }
  </style>
</head>
<body>
<div class="container">
  <%= yield %>
</div>
</body>
</html>