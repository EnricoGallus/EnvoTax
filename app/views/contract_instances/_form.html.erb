<%= form_with(model: [contract, contract_instance], class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: contract_instance } %>

  <div class="my-5">
    <%= form.label :start_date %>
    <%= form.date_field :start_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract_instance.errors[:start_date].none?, "border-red-400 focus:outline-red-600": contract_instance.errors[:start_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :end_date %>
    <%= form.date_field :end_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract_instance.errors[:end_date].none?, "border-red-400 focus:outline-red-600": contract_instance.errors[:end_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :budget_limit %>
    <%= form.number_field :budget_limit, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": contract_instance.errors[:budget_limit].none?, "border-red-400 focus:outline-red-600": contract_instance.errors[:budget_limit].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
