<div id="<%= dom_id contract_instance %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Contract:</strong>
    <%= contract_instance.contract.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= contract_instance.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= contract_instance.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Budget limit:</strong>
    <%= contract_instance.budget_limit&.format %>
  </div>
</div>
