<% content_for :title, "Showing contract instance" %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl">Showing contract instance</h1>

  <%= render @contract_instance %>

  <%= link_to t('table.edit'), edit_contract_contract_instance_path(@contract, @contract_instance), class: "btn btn-primary" %>
  <%= link_to t('table.back'), contract_path(@contract), class: "btn" %>
  <div class="sm:inline-block mt-2 sm:mt-0 sm:ml-2">
    <%= button_to t('table.delete'), contract_contract_instance_path(@contract, @contract_instance), method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
  </div>
</div>
