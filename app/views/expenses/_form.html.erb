<%= form_with(model: expense, class: "contents") do |form| %>
  <% if expense.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:</h2>

      <ul class="list-disc ml-6">
        <% expense.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :amount %>
    <%= form.text_field :amount, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:amount].none?, "border-red-400 focus:outline-red-600": expense.errors[:amount].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :category %>
    <%= form.select :category, options_for_select(Expense.categories.keys.map { |category| [category.humanize, category] }, selected: expense.category), {}, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:category].none?, "border-red-400 focus:outline-red-600": expense.errors[:category].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 4, class: ["textarea w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:description].none?, "border-red-400 focus:outline-red-600": expense.errors[:description].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :date %>
    <%= form.date_field :date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:date].none?, "border-red-400 focus:outline-red-600": expense.errors[:date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :receipt %>
    <%= form.file_field :receipt, class: ["file-input w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:project_id].none?, "border-red-400 focus:outline-red-600": expense.errors[:project_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :client_id %>
    <%= form.select :client_id, options_from_collection_for_select(Client.all, :id, :name, selected: expense.client_id), { include_blank: true }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": expense.errors[:client_id].none?, "border-red-400 focus:outline-red-600": expense.errors[:client_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
