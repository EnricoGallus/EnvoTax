<%= form_with(model: expense, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: expense } %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <div>
      <%= form.label :amount %>
      <%= form.text_field :amount, class: ["input w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:amount].none?, "border-red-400 focus:outline-red-600": expense.errors[:amount].any? }] %>
    </div>

    <div>
      <%= form.label :date %>
      <%= form.date_field :date, class: ["input w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:date].none?, "border-red-400 focus:outline-red-600": expense.errors[:date].any? }] %>
    </div>

    <div>
      <%= form.label :cost_type %>
      <%= form.collection_select :cost_type_id, CostType.all, :id, :name, { include_blank: true }, class: ["select w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:cost_type].none?, "border-red-400 focus:outline-red-600": expense.errors[:cost_type].any? }] %>
    </div>

    <div>
      <%= form.label :contract_instance %>
      <%= form.collection_select :contract_instance_id, ContractInstance.all, :id, :name, { include_blank: true }, class: ["select w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:contract].none?, "border-red-400 focus:outline-red-600": expense.errors[:contract].any? }] %>
    </div>

  </div>
  <div class="grid grid-cols-1 gap-4 pb-5">

    <div class="mt-4">
      <%= form.label :description %>
      <%= form.textarea :description, rows: 4, class: ["textarea w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:description].none?, "border-red-400 focus:outline-red-600": expense.errors[:description].any? }] %>
    </div>

    <div>
      <%= form.label :receipt %>
      <%= form.file_field :receipt, class: ["file-input w-full", { "border-gray-400 focus:outline-blue-600": expense.errors[:receipt].none?, "border-red-400 focus:outline-red-600": expense.errors[:receipt].any? }] %>
    </div>

  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
