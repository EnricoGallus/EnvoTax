<% content_for :title, t('expense.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('expense.index.title') %></h1>
    <%= link_to t('expense.index.new'), new_expense_path, class: "btn btn-primary btn-lg" %>
  </div>

  <%= render 'search_form', locale: { q: @q } %>

  <div id="expenses" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @expenses.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= sort_link(@q, :amount_cents, t('activerecord.attributes.expense.amount')) %></th>
            <th><%= sort_link(@q, :cost_type_name, t('activerecord.attributes.expense.cost_type')) %></th>
            <th><%= sort_link(@q, :date, t('activerecord.attributes.expense.date')) %></th>
            <th><%= sort_link(@q, :contract_instance_name, t('activerecord.attributes.expense.contract_instance')) %></th>
            <th><%= sort_link(@q, :description, t('activerecord.attributes.expense.description')) %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @expenses.each do |expense| %>
            <tr id="<%= dom_id expense %>">
              <td><%= expense.amount.format %></td>
              <td><%= expense.cost_type.name %></td>
              <td><%= expense.date %></td>
              <td><%= expense.contract_instance&.name %></td>
              <td><%= expense.description %></td>
              <td>
                <%= link_to t('table.show'), expense, class: "btn btn-accent" %>
                <%= link_to t('table.edit'), edit_expense_path(expense), class: "btn btn-primary" %>
                <div class="inline-block">
                  <%= button_to t('table.delete'), expense, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('expense.index.none_found') %></p>
    <% end %>
  </div>
</div>
