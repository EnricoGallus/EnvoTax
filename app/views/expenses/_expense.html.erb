<div id="<%= dom_id expense %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= expense.amount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Cost Type:</strong>
    <%= expense.cost_type.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= expense.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Date:</strong>
    <%= expense.date %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('activerecord.attributes.expense.contract') %>:</strong>
    <%= expense.contract&.name %>
  </div>
  <div>
    <% if expense.receipt.representable? %>
      <%= image_tag expense.receipt.representation(resize_to_limit: [100, 100]) %>
    <% elsif expense.receipt.attached? %>
      <%= link_to "Download", rails_blob_path(expense.receipt, disposition: "attachment") %>
    <% end %>
  </div>
</div>
