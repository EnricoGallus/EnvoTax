<% content_for :title, "Showing expense" %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl">Showing expense</h1>

  <%= render @expense %>

  <%= link_to t('table.edit'), edit_expense_path(@expense), class: "btn btn-primary" %>
  <%= link_to t('table.back'), expenses_path, class: "btn" %>
  <div class="sm:inline-block mt-2 sm:mt-0 sm:ml-2">
    <%= button_to t('table.delete'), @expense, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
  </div>
</div>
