<%= form_with(model: invoice, class: "contents") do |form| %>
  <% if invoice.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(invoice.errors.count, "error") %> prohibited this invoice from being saved:</h2>

      <ul class="list-disc ml-6">
        <% invoice.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :client_id %>
    <%= form.select :client_id, options_from_collection_for_select(Client.all, :id, :name, selected: invoice.client_id), { prompt: t('select.all') }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": invoice.errors[:client_id].none?, "border-red-400 focus:outline-red-600": invoice.errors[:client_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :category_id %>
    <%= form.collection_select :category_id, Category.all, :id, :name, { include_blank: true }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": invoice.errors[:category].none?, "border-red-400 focus:outline-red-600": invoice.errors[:category].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :start_date %>
    <%= form.date_field :start_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": invoice.errors[:start_date].none?, "border-red-400 focus:outline-red-600": invoice.errors[:start_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :end_date %>
    <%= form.date_field :end_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": invoice.errors[:end_date].none?, "border-red-400 focus:outline-red-600": invoice.errors[:end_date].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :invoice_date %>
    <%= form.date_field :invoice_date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": invoice.errors[:invoice_date].none?, "border-red-400 focus:outline-red-600": invoice.errors[:invoice_date].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
