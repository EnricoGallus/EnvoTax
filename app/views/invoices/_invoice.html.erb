<div id="<%= dom_id invoice %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Client:</strong>
    <%= invoice.client_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= invoice.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= invoice.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= invoice.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= invoice.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Invoice data:</strong>
    <%= invoice.invoice_date %>
  </div>
</div>
