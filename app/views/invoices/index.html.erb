<%= render(IndexPageComponent.new(
  content_title: t('invoice.index.content_title'),
  title: t('invoice.index.title'),
  model_name: 'invoice',
  new_path: new_invoice_path,
  new_text: t('invoice.index.new'),
  collection: @invoices
)) do %>
  <%= render(DataTableComponent.new(collection: @invoices, edit_path: false)) do |component| %>
    <% component.with_headers do %>
      <td><%= sort_link(@q, :contract_instance_name, t('activerecord.attributes.invoice.contract')) %></td>
      <td><%= sort_link(@q, :invoice_date, t('activerecord.attributes.invoice.invoice_date')) %></td>
      <td><%= sort_link(@q, :status, t('activerecord.attributes.invoice.status')) %></td>
      <td><%= t('invoice.index.table.sum') %></td>
    <% end %>

    <% @invoices.each do |invoice| %>
      <% component.with_row do %>
        <td><%= invoice.contract_instance.name %></td>
        <td><%= invoice.invoice_date %></td>
        <td><%= invoice.status %></td>
        <td><%= invoice.total_amount.format %></td>

        <% component.with_custom_actions do %>
          <%= link_to t('table.preview'), preview_invoice_path(invoice), class: "btn btn-accent" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>