<%= render(IndexPageComponent.new(
  content_title: t('invoices.index.content_title'),
  title: t('invoices.index.title'),
  model_name: 'invoice',
  new_path: new_invoice_path,
  new_text: t('invoices.index.new'),
  collection: @invoices
)) do %>
  <%= render(DataTableComponent.new(collection: @invoices)) do |component| %>
    <% component.with_headers do %>
      <td><%= sort_link(@q, :contract_instance_name, t('activerecord.attributes.invoice.contract')) %></td>
      <td><%= sort_link(@q, :invoice_date, t('activerecord.attributes.invoice.invoice_date')) %></td>
      <td><%= sort_link(@q, :status, t('activerecord.attributes.invoice.status')) %></td>
      <td><%= t('invoices.index.table.sum') %></td>
    <% end %>

    <% @invoices.each do |invoice| %>
      <% component.with_row do %>
        <td><%= invoice.contract_instance.name %></td>
        <td><%= invoice.invoice_date %></td>
        <td><%= invoice.status %></td>
        <td><%= invoice.total_amount.format %></td>
      <% end %>

      <%= component.with_custom_actions do %>
        <%= link_to t('table.preview'), invoice_path(invoice, format: :pdf), class: "btn btn-accent", target: "_blank" %>
        <%= button_to t('table.delete'), invoice, method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: t('table.delete_confirmation') } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>