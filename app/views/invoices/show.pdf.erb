<!-- app/views/invoices/show.pdf.erb -->
<div class="invoice-header">
  <div class="row">
    <div class="col text-center">
      <h1><%= t('invoice.header.title') %></h1>
    </div>
    <!--<div class="col-6 text-end">
      <%# if @user.company_logo.attached? %>
        <%#= wicked_pdf_image_tag(url_for(@user.company_logo), style: "height: 80px;") %>
      <%# end %>
    </div>-->
  </div>
  <div class="row">
    <div class="col">
      <p class="lead"><%= t('invoice.header.date', date: l(@invoice.invoice_date, format: :default)) %></p>
    </div>
    <div class="col">
      <p class="lead"><%= t('invoice.header.period', from: l(@invoice.start_date, format: :default), to: l(@invoice.end_date, format: :default)) %></p>
    </div>
    <div class="col">
      <p class="lead"><%= t('invoice.header.reference_id', number: @invoice.invoice_number) %></p>
    </div>
  </div>
</div>

<table class="table">
  <tr>
    <td>
      <h5 class="fw-bold mb-2"><%= t('invoice.from.title') %></h5>
      <div><%= @user.name %></div>
      <div><%= t('invoice.address.postal_code', zip: @user.address.postal_code) %></div>
      <div><%= @user.address.to_formatted_address %></div>
      <div><%= @user.email %></div>
    </td>
    <td class="text-end">
      <% client = @invoice.contract_instance.contract.client %>
      <h5 class="fw-bold mb-2"><%= t('invoice.to.title') %></h5>
      <div><%= t('invoice.to.client_name', name: client.name) %></div>
      <% unless client.address.nil? %>
        <div><%= t('invoice.address.postal_code', zip: client.address.postal_code) %></div>
        <div><%= client.address.to_formatted_address %></div>
      <% end %>
      <%# if @invoice.client.email.present? %>
      <!--TODO: add client contact-->
      <!--<p><%#= @invoice.client.email %></p>-->
      <%# end %>
    </td>
  </tr>
</table>

<div class="mb-4">
  <h3 class="fw-bold mb-3"><%= t('invoice.billing_details.title') %></h3>
  <table class="table table-striped">
    <thead>
    <tr>
      <th><%= t('invoice.billing_details.date') %></th>
      <th><%= t('invoice.billing_details.description') %></th>
      <th class="text-end"><%= t('invoice.billing_details.amount') %></th>
    </tr>
    </thead>
    <tbody>
    <% if @invoice.expenses.any? %>
      <% @invoice.expenses.each do |expense| %>
        <tr>
          <td><%= l(expense.date, format: :default) %></td>
          <td><%= expense.description %></td>
          <td class="text-end"><%= (expense.credit? ? '-' : '') + expense.amount.format %></td>
        </tr>
        <% if expense.receipt.attached? %>
          <tr>
            <td colspan="3" class="text-center">
              <div style="page-break-inside: avoid; max-height: 250px; overflow: hidden;">
                <% begin %>
                  <% blob = expense.receipt.blob %>
                  <% image_data = Base64.strict_encode64(blob.download) %>
                  <img src="data:<%= blob.content_type %>;base64,<%= image_data %>"
                       style="max-height: 200px; max-width: 95%;">
                <% rescue => e %>
                  <p class="text-danger">Error loading receipt: <%= e.message %></p>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
    </tbody>
  </table>
</div>

<div class="row mb-4">
  <div class="col-6 offset-6">
    <table class="table">
      <tr class="fw-bold">
        <td><%= t('invoice.billing_details.total') %></td>
        <td class="text-end"><%= @invoice.total_amount.format %></td>
      </tr>
    </table>
  </div>
</div>
<p><%= t('invoice.tax.included') %></p>

<table class="table table-borderless mb-4">
  <tr>
    <td>
      <h5 class="fw-bold mb-2"><%= t('invoice.bank_details.title') %></h5>
      <div><%= t('invoice.bank_details.bank', name: @user.bank_account.bank_name) %></div>
      <div><%= t('invoice.bank_details.branch', name: @user.bank_account.branch_code) %></div>
      <div><%= t('invoice.bank_details.type', name: @user.bank_account.account_type) %></div>
      <div><%= t('invoice.bank_details.account_number', name: @user.bank_account.account_number) %></div>
      <div><%= t('invoice.bank_details.account_holder', name: @user.bank_account.account_holder) %></div>
    </td>
  </tr>
</table>

<% if @invoice.time_entries.any? %>
  <div class="mb-4">
    <h5 class="fw-bold mb-3"><%= t('activerecord.models.time_entry.other') %></h5>
    <table class="table table-striped">
      <thead>
      <tr>
        <th><%= t('activerecord.attributes.time_entry.date') %></th>
        <th><%= t('activerecord.attributes.time_entry.project') %></th>
        <th>From</th>
        <th>To</th>
        <th class="text-end">Hours</th>
        <th class="text-end">Rate</th>
        <th class="text-end">Amount</th>
      </tr>
      </thead>
      <tbody>
      <% @invoice.time_entries.includes(:project).each do |entry| %>
        <tr>
          <td><%= entry.date&.strftime('%b %d, %Y') %></td>
          <td><%= entry.project.name %></td>
          <td><%= entry.time_from&.strftime('%H:%M') %></td>
          <td><%= entry.time_to&.strftime('%H:%M') %></td>
          <td class="text-end"><%= ((entry.time_to - entry.time_from) / 1.hour).round(2) if entry.time_from && entry.time_to %></td>
          <td class="text-end"><%= entry.project.client.hourly_rate.format %></td>
          <td class="text-end"><%= entry.calculate_cost.format %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% end %>