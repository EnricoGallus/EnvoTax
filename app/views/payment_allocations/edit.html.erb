<% content_for :title, t('payment_allocation.edit.content_title') %>

<div class="w-full">
  <h1 class="font-bold text-4xl"><%= t('payment_allocation.edit.title') %></h1>

  <%= render "form", payment_statement: @payment_statement, payment_allocation: @payment_allocation %>

  <%= link_to t('table.show'), payment_statement_payment_allocation_path(@payment_statement, @payment_allocation), class: "btn btn-accent" %>
  <%= link_to t('table.back'), payment_statement_path(@payment_statement), class: "btn" %>
</div>
