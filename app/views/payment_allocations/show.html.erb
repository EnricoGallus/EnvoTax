<% content_for :title, "Showing payment allocation" %>

<div class="w-full">

  <h1 class="font-bold text-4xl">Showing payment allocation</h1>

  <%= render partial: "payment_allocations/payment_allocation", locals: { payment_allocation: @payment_allocation } %>

  <%= link_to t('table.edit'), edit_payment_statement_payment_allocation_path(@payment_statement, @payment_allocation), class: "btn btn-primary" %>
  <%= link_to t('table.back'), payment_statement_path(@payment_statement), class: "btn" %>
  <%= button_to t('table.delete'), payment_statement_payment_allocation_path(@payment_statement, @payment_allocation), method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: t('table.delete_confirmation') } %>
</div>
