<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('payment_allocation.index.title') %></h1>
    <%= link_to t('payment_allocation.index.new'), new_payment_statement_payment_allocation_path(@payment_statement), class: "btn btn-primary btn-lg" %>
  </div>

  <div id="payment_allocations" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @payment_statement.payment_allocations.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= t('activerecord.attributes.payment_allocation.amount') %></th>
            <th><%= t('activerecord.attributes.payment_allocation.tax') %></th>
            <th><%= t('activerecord.attributes.payment_allocation.reference') %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @payment_statement.payment_allocations.each do |payment_allocation| %>
            <tr id="<%= dom_id payment_allocation %>">
              <td><%= payment_allocation.amount %></td>
              <td><%= payment_allocation.income_tax.tax_type %></td>
              <td><%= payment_allocation.reference %></td>
              <td>
                <%= link_to t('table.show'), payment_statement_payment_allocation_path(@payment_statement, payment_allocation), class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_payment_statement_payment_allocation_path(@payment_statement, payment_allocation), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), payment_statement_payment_allocation_path(@payment_statement, payment_allocation), method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('payment_allocation.index.none_found') %></p>
    <% end %>
  </div>
</div>