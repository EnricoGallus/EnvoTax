<%= form_with(model: [payment_statement, payment_allocation], class: "contents") do |form| %>
  <% if payment_allocation.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(payment_allocation.errors.count, "error") %> prohibited this payment_allocation from being saved:</h2>

      <ul class="list-disc ml-6">
        <% payment_allocation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :amount %>
    <%= form.number_field :amount, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": payment_allocation.errors[:amount].none?, "border-red-400 focus:outline-red-600": payment_allocation.errors[:amount].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :income_tax_id %>
    <%= form.select :income_tax_id, options_from_collection_for_select(IncomeTax.all, :id, :tax_type, selected: payment_allocation.income_tax_id), { include_blank: true }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": payment_allocation.errors[:income_tax].none?, "border-red-400 focus:outline-red-600": payment_allocation.errors[:income_tax].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :allocate_to %>
    <%= form.select :allocate_to, options_for_select(
      (Invoice.all.map { |invoice| ["Invoice ##{invoice.id}", "Invoice_#{invoice.id}"] } +
        PaymentAdjustment.all.map { |pa| ["Payment Adjustment ##{pa.id}", "PaymentAdjustment_#{pa.id}"] })
    ), { prompt: "Select Reference" }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": payment_allocation.errors[:allocate_to].none?, "border-red-400 focus:outline-red-600": payment_allocation.errors[:allocate_to].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
