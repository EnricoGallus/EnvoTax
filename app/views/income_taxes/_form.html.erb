<%= form_with(model: income_tax, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: income_tax } %>

  <div class="my-5">
    <%= form.label :tax_type %>
    <%= form.text_field :tax_type, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": income_tax.errors[:tax_type].none?, "border-red-400 focus:outline-red-600": income_tax.errors[:tax_type].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :tax_rate %>
    <%= form.text_field :tax_rate, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": income_tax.errors[:tax_rate].none?, "border-red-400 focus:outline-red-600": income_tax.errors[:tax_rate].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
