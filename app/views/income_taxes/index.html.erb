<% content_for :title, t('income_tax.index.content_title') %>

<div class="w-full">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t('income_tax.index.title') %></h1>
    <%= link_to t('income_tax.index.new'), new_income_tax_path, class: "btn btn-primary btn-lg" %>
  </div>

  <div id="income_taxes" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @income_taxes.any? %>
      <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
        <table class="table">
          <thead>
          <tr>
            <th><%= sort_link(@q, :tax_type, t('activerecord.attributes.income_tax.tax_type')) %></th>
            <th><%= sort_link(@q, :tax_rate, t('activerecord.attributes.income_tax.tax_rate')) %></th>
            <th><%= t('table.actions') %></th>
          </tr>
          </thead>
          <tbody>
          <% @income_taxes.each do |income_tax| %>
            <tr id="<%= dom_id income_tax %>">
              <td><%= income_tax.tax_type %></td>
              <td><%= income_tax.tax_rate %></td>
              <td>
                <%= link_to t('table.show'), income_tax, class: "btn btn-primary" %>
                <%= link_to t('table.edit'), edit_income_tax_path(income_tax), class: "btn btn-primary" %>
                <div class="sm:inline-block">
                  <%= button_to t('table.delete'), income_tax, method: :delete, class: "btn btn-error", data: { turbo_confirm: t('table.delete_confirmation') } %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10"><%= t('income_tax.index.none_found') %></p>
    <% end %>
  </div>
</div>