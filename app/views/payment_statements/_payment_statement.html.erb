<div id="<%= dom_id payment_statement %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1"><%= t('activerecord.attributes.payment_statement.client') %>:</strong>
    <%= payment_statement.client.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('activerecord.attributes.payment_statement.amount') %>:</strong>
    <%= payment_statement.amount.format %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('activerecord.attributes.payment_statement.received_on') %>:</strong>
    <%= payment_statement.received_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('activerecord.attributes.payment_statement.status') %>:</strong>
    <%= payment_statement.status %>
  </div>
</div>
