<% content_for :title, t('payment_statement.show.content_title') %>

<div class="flex flex-col w-full">
  <div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      <h1 class="font-bold text-4xl"><%= t('payment_statement.show.title') %></h1>
      <div>
        <%= link_to t('table.edit'), edit_payment_statement_path(@payment_statement), class: "btn btn-primary" %>
        <%= link_to t('table.back'), payment_statements_path, class: "btn" %>
        <%= button_to t('table.delete'), @payment_statement, method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>

    <%= render @payment_statement %>
  </div>

  <%= render 'payment_allocations/index', payment_statement: @payment_statement %>
</div>
