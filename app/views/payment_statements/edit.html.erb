<% content_for :title, "Editing payment statement" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing payment statement</h1>

  <%= render "form", payment_statement: @payment_statement %>

  <%= link_to "Show this payment statement", @payment_statement, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to payment statements", payment_statements_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
