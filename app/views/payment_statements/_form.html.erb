<%= form_with(model: payment_statement, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: payment_statement } %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 py-5">
    <div>
      <%= form.label :client %>
      <%= form.select :client_id, options_from_collection_for_select(Client.all, :id, :name, selected: payment_statement.client_id), { include_blank: true }, class: ["select w-full", { "border-gray-400 focus:outline-blue-600": payment_statement.errors[:client].none?, "border-red-400 focus:outline-red-600": payment_statement.errors[:client].any? }] %>
    </div>

    <div>
      <%= form.label :amount %>
      <%= form.text_field :amount, class: ["input w-full", { "border-gray-400 focus:outline-blue-600": payment_statement.errors[:amount].none?, "border-red-400 focus:outline-red-600": payment_statement.errors[:amount].any? }] %>
    </div>

    <div>
      <%= form.label :received_on %>
      <%= form.date_field :received_on, class: ["input w-full", { "border-gray-400 focus:outline-blue-600": payment_statement.errors[:received_on].none?, "border-red-400 focus:outline-red-600": payment_statement.errors[:received_on].any? }] %>
    </div>

    <div>
      <%= form.label :receipt %>
      <%= form.file_field :receipt, class: ["file-input w-full", { "border-gray-400 focus:outline-blue-600": payment_statement.errors[:receipt].none?, "border-red-400 focus:outline-red-600": payment_statement.errors[:receipt].any? }] %>
    </div>

  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
