<%= form.hidden_field :id %>

<div class="my-5">
  <%= form.label :postal_code %>
  <%= form.text_field :postal_code, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:postal_code].none?, "border-red-400 focus:outline-red-600": address.errors[:postal_code].any?}] %>
</div>

<div class="my-5">
  <%= form.label :prefecture %>
  <%= form.text_field :prefecture, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:prefecture].none?, "border-red-400 focus:outline-red-600": address.errors[:prefecture].any?}] %>
</div>

<div class="my-5">
  <%= form.label :city %>
  <%= form.text_field :city, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:city].none?, "border-red-400 focus:outline-red-600": address.errors[:city].any?}] %>
</div>

<div class="my-5">
  <%= form.label :street %>
  <%= form.text_field :street, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:street].none?, "border-red-400 focus:outline-red-600": address.errors[:street].any?}] %>
</div>

<div class="my-5">
  <%= form.label :building %>
  <%= form.text_field :building, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:building].none?, "border-red-400 focus:outline-red-600": address.errors[:building].any?}] %>
</div>

<div class="my-5">
  <%= form.label :country %>
  <%= form.select :country, Address.countries.keys.map { |country| [country.humanize, country] }, {}, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": address.errors[:country].none?, "border-red-400 focus:outline-red-600": address.errors[:country].any?}] %>
</div>