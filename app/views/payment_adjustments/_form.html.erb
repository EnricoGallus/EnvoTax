<%= form_with(model: payment_adjustment, class: "contents") do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: payment_adjustment } %>

  <div class="my-5">
    <%= form.label :client_id %>
    <%= form.select :client_id, options_from_collection_for_select(Client.all, :id, :name, selected: payment_adjustment.client_id), { include_blank: true }, class: ["select w-full", {"border-gray-400 focus:outline-blue-600": payment_adjustment.errors[:client].none?, "border-red-400 focus:outline-red-600": payment_adjustment.errors[:client].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :amount %>
    <%= form.text_field :amount, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": payment_adjustment.errors[:amount].none?, "border-red-400 focus:outline-red-600": payment_adjustment.errors[:amount].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_field :description, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": payment_adjustment.errors[:description].none?, "border-red-400 focus:outline-red-600": payment_adjustment.errors[:description].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :date %>
    <%= form.date_field :date, class: ["input w-full", {"border-gray-400 focus:outline-blue-600": payment_adjustment.errors[:date].none?, "border-red-400 focus:outline-red-600": payment_adjustment.errors[:date].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
