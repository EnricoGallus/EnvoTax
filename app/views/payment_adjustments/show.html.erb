<% content_for :title, t('payment_adjustment.show.content_title') %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl"><%= t('payment_adjustment.show.title') %></h1>

  <%= render @payment_adjustment %>

  <%= link_to t('table.edit'), edit_payment_adjustment_path(@payment_adjustment), class: "btn btn-primary" %>
  <%= link_to t('table.back'), payment_adjustments_path, class: "btn" %>
  <%= button_to t('table.delete'), @payment_adjustment, method: :delete, class: "btn btn-error", form_class: "inline-block", data: { turbo_confirm: t('table.delete_confirmation') } %>
</div>
