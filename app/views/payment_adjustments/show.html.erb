<% content_for :title, "Showing payment adjustment" %>

<div class="md:w-2/3 w-full">

  <h1 class="font-bold text-4xl">Showing payment adjustment</h1>

  <%= render @payment_adjustment %>

  <%= link_to "Edit this payment adjustment", edit_payment_adjustment_path(@payment_adjustment), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to payment adjustments", payment_adjustments_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <div class="sm:inline-block mt-2 sm:mt-0 sm:ml-2">
    <%= button_to "Destroy this payment adjustment", @payment_adjustment, method: :delete, class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
